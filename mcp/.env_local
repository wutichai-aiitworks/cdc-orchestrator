# Local cargo (`./start.sh --build .env_local`)
# Compose mcp-cdc already binds 127.0.0.1:8410 — stop that container first:
#   docker compose --profile mcp stop mcp-cdc
#
# Token matches hyper-cdc-orchestrator/.env so Cursor MCP config stays the same.

MCP_BIND_ADDR=127.0.0.1:8410
MCP_BEARER_TOKEN=change-me-mcp-cdc-token-min24chars
CDC_ORCHESTRATOR_URL=http://127.0.0.1:9788
# CDC_ORCHESTRATOR_TOKEN=
ALLOW_WRITE_TOOLS=true
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_RPM=300
# MCP_CORS_ORIGINS=
RUST_LOG=info,mcp_cdc=info
