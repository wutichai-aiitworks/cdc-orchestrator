# Copy to .env.production, replace every REPLACE_ME value, and keep the file
# outside version control. Redpanda uses the Phase 3A memory/reserve values.
# docker-compose.prod.yaml retains shared-host compatibility flags. A dedicated
# native Linux host may additionally apply docker-compose.prod-linux.yaml.

CDC_ENV_FILE=.env.production

# ── Required production control-plane settings ───────────────
ORCH_ENV=prod
ORCH_ENABLED=true
ORCH_REQUIRE_AUTH=true
ORCH_REQUIRE_PERSISTENCE=true
ORCH_STRICT_PERSISTENCE=true
ORCH_API_TOKEN=REPLACE_ME_WITH_AT_LEAST_24_RANDOM_CHARACTERS
ORCH_JDBC_ADMIN_TOKEN=REPLACE_ME_WITH_A_SEPARATE_RANDOM_TOKEN
ORCH_RQLITE_URL=http://cdc-rqlite:4001
ORCH_JDBC_ADMIN_URL=http://cdc-jdbc-admin:8084
ORCH_SCHEMA_REGISTRY_URL=http://cdc-message:8081
ORCH_KSQL_URL=http://cdc-ksqldb:8088
ORCH_COMMAND_TIMEOUT_SECS=30
ORCH_POLL_INTERVAL_MS=30000
ORCH_HISTORY_CAPACITY=500
ORCH_STOP_DELETES_CONNECTOR=false

# Optional rqlite authentication. Configure matching credentials on rqlite
# before enabling these values.
# ORCH_RQLITE_USER=
# ORCH_RQLITE_PASS=

# ── Images and host bindings ─────────────────────────────────
# Replace local tags with tested immutable registry tags/digests before release.
CDC_ORCHESTRATOR_IMAGE=cdc-orchestrator:local
CDC_CONNECT_IMAGE=cdc-connect:local
CDC_JDBC_ADMIN_IMAGE=cdc-jdbc-admin:local
CDC_NATIVE_UI_IMAGE=kafbat-webui:local
MCP_CDC_IMAGE=mcp-cdc:local

CDC_ORCHESTRATOR_BIND=127.0.0.1
CDC_ORCHESTRATOR_PORT=9788
CDC_CONNECT_HOST_PORT=28083
CDC_ADMIN_HOST_PORT=28080
CDC_NATIVE_UI_HOST_PORT=4320
CDC_KAFKA_HOST_PORT=19092
CDC_SCHEMA_REGISTRY_HOST_PORT=18081
CDC_KSQL_HOST_PORT=28088
CDC_REDIS_HOST_PORT=26379
CDC_RQLITE_HOST_PORT=14001

# ── Phase 3A Redpanda resource values ────────────────────────
CDC_REDPANDA_SMP=1
CDC_REDPANDA_MEMORY=2G
CDC_REDPANDA_RESERVE_MEMORY=256M

# ── Phase 2 Kafka Connect tuning ──────────────────────────────
CDC_CONNECT_HEAP_OPTS=-Xms1g -Xmx2g
CDC_CONNECT_PRODUCER_COMPRESSION_TYPE=lz4
CDC_CONNECT_PRODUCER_BATCH_SIZE=131072
CDC_CONNECT_PRODUCER_LINGER_MS=20
CDC_CONNECT_CONSUMER_MAX_POLL_RECORDS=500
# Preserve the current 60-second offset flush during the first tuning rollout.
CDC_CONNECT_OFFSET_FLUSH_INTERVAL_MS=60000
CDC_CONNECT_OFFSET_FLUSH_TIMEOUT_MS=5000

# ── Phase 4 retention policy ─────────────────────────────────
# APPLY=false is a read-only validation mode. Keep retention bytes empty until
# production-like peak throughput has been measured.
CDC_REDPANDA_RETENTION_APPLY=false
CDC_REDPANDA_RETENTION_MS=604800000
CDC_REDPANDA_DLQ_RETENTION_MS=2592000000
CDC_REDPANDA_SEGMENT_BYTES=134217728
CDC_REDPANDA_RETENTION_BYTES=

# ── MCP ──────────────────────────────────────────────────────
MCP_CDC_BIND=127.0.0.1
MCP_CDC_PORT=8410
MCP_BEARER_TOKEN=REPLACE_ME_WITH_A_SEPARATE_MCP_TOKEN_MIN_24_CHARS
ALLOW_WRITE_TOOLS=false
