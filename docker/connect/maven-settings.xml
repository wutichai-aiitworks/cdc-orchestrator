<?xml version="1.0" encoding="UTF-8"?>
<!-- Prefer Maven Central so io.confluent parent plugins are not probed on
     packages.confluent.io first (that repo 404s most artifacts and adds ~1s
     per dependency). The kafka-connect-jdbc pom still uses id "confluent"
     for Confluent-only artifacts. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>maven-central</id>
      <name>Maven Central</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>*,!confluent</mirrorOf>
    </mirror>
  </mirrors>
</settings>
