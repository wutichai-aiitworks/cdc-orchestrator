# ── Orchestrator ──────────────────────────────────────────────
# dev | prod  (prod requires strong token + rqlite persistence)
# Compose service env file; production sets this to .env.production.
CDC_ENV_FILE=.env
ORCH_ENV=dev
ORCH_ENABLED=true
ORCH_COMMAND_TIMEOUT_SECS=30
ORCH_POLL_INTERVAL_MS=30000
ORCH_HISTORY_CAPACITY=500
ORCH_STOP_DELETES_CONNECTOR=false

# CDC uses Avro + Schema Registry by default (Redpanda on 8081 / host 18081)
ORCH_SCHEMA_REGISTRY_URL=http://cdc-message:8081
ORCH_KSQL_URL=http://cdc-ksqldb:8088

# Auth — REQUIRED when ORCH_ENV=prod (min 24 chars)
# ORCH_API_TOKEN=replace-with-long-random-token-here

# rqlite stores pipelines, drafts, notification rules, and processing specs
ORCH_RQLITE_URL=http://cdc-rqlite:4001
# ORCH_RQLITE_USER=
# ORCH_RQLITE_PASS=

# JDBC Type 4 control-plane admin (catalog, validate, DDL, preview)
ORCH_JDBC_ADMIN_URL=http://cdc-jdbc-admin:8084
# ORCH_JDBC_ADMIN_TOKEN=

# Separate Kafka-native cdc-processor data plane
# CDC_BOOTSTRAP_SERVERS=127.0.0.1:19092
# CDC_PIPELINE_CONFIG=examples/customer-pipeline.json
# DATA_SERVICE_API_KEY=your-api-key

# ── Publish / bind ────────────────────────────────────────────
# Docker install.sh defaults below. For local cargo use .env_local (4320–4328)
# so ports stay clear of Agentics 4300–4317. Native UI: kafbat-webui/.env_local.
CDC_ORCHESTRATOR_IMAGE=cdc-orchestrator:local
CDC_ORCHESTRATOR_BIND=127.0.0.1
CDC_ORCHESTRATOR_PORT=9788
CDC_CONNECT_HOST_PORT=28083
CDC_ADMIN_HOST_PORT=4321
# Level 2 (forked Kafbat UI image override):
# CDC_ADMIN_IMAGE=ghcr.io/<your-org>/kafka-ui:ux-v1
# Level 3 native UI (profile: native-ui):
# CDC_NATIVE_UI_IMAGE=kafbat-webui:local
CDC_NATIVE_UI_HOST_PORT=4320
CDC_KAFKA_HOST_PORT=19092
CDC_SCHEMA_REGISTRY_HOST_PORT=18081
CDC_KSQL_HOST_PORT=28088
CDC_REDIS_HOST_PORT=26379
CDC_RQLITE_HOST_PORT=14001
CDC_POSTGRES_HOST_PORT=25432
CDC_POSTGRES_TARGET_HOST_PORT=25433

# ── Phase 3A Redpanda resource settings ──────────────────────
# Used with the production overlays. The portable overlay keeps shared-host
# compatibility flags; the dedicated Linux overlay removes --overprovisioned.
CDC_REDPANDA_SMP=1
CDC_REDPANDA_MEMORY=2G
CDC_REDPANDA_RESERVE_MEMORY=256M

# ── Phase 2 Kafka Connect production tuning ──────────────────
CDC_CONNECT_HEAP_OPTS=-Xms1g -Xmx2g
CDC_CONNECT_PRODUCER_COMPRESSION_TYPE=lz4
CDC_CONNECT_PRODUCER_BATCH_SIZE=131072
CDC_CONNECT_PRODUCER_LINGER_MS=20
CDC_CONNECT_CONSUMER_MAX_POLL_RECORDS=500
# Keep the current effective 60-second flush for the first rollout. A shorter
# interval is a separate measured change after restart/replay validation.
CDC_CONNECT_OFFSET_FLUSH_INTERVAL_MS=60000
CDC_CONNECT_OFFSET_FLUSH_TIMEOUT_MS=5000

# Phase 4 Redpanda/topic policy. Phase 2 never applies these values.
# The current live cluster was observed with 7-day retention and 128 MiB segments.
CDC_REDPANDA_RETENTION_APPLY=false
CDC_REDPANDA_RETENTION_MS=604800000
CDC_REDPANDA_DLQ_RETENTION_MS=2592000000
CDC_REDPANDA_SEGMENT_BYTES=134217728
CDC_REDPANDA_RETENTION_BYTES=

# ── Demo Postgres source + target (--profile demo) ────────────
CDC_DEMO_PG_USER=demo
CDC_DEMO_PG_PASSWORD=demo
CDC_DEMO_PG_DB=demo
# Dump window loaded into source on first init: 3m | 6m | 1y | 2y
CDC_DEMO_DUMP_SIZE=3m

# ── MCP (--profile mcp) ───────────────────────────────────────
MCP_CDC_IMAGE=mcp-cdc:local
MCP_CDC_BIND=127.0.0.1
MCP_CDC_PORT=8410
MCP_BEARER_TOKEN=change-me-mcp-cdc-token-min24chars
# Set true for Cursor/agent prompting (create/start pipelines). Keep false in shared/prod.
ALLOW_WRITE_TOOLS=false

# pgcopydb sidecar
ORCH_PGCOPY_URL=http://cdc-pgcopydb:8085
ORCH_PGCOPY_TOKEN=
CDC_PGCOPY_IMAGE=cdc-pgcopydb:local
