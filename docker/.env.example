# ── Orchestrator ──────────────────────────────────────────────
# Compose service env file; production sets this to .env.production.
CDC_ENV_FILE=.env
# APP_MODE — the one deployment-mode variable: Production | Maintenance | Enhanced.
#   Production  : no ribbon; requires a strong ORCH_API_TOKEN + rqlite (ORCH_REQUIRE_* override)
#   Maintenance : amber corner ribbon — stable release, fixes only
#   Enhanced    : violet corner ribbon — new features in development
APP_MODE=Enhanced
ORCH_ENABLED=true
ORCH_COMMAND_TIMEOUT_SECS=30
ORCH_POLL_INTERVAL_MS=30000
ORCH_HISTORY_CAPACITY=500
ORCH_STOP_DELETES_CONNECTOR=false

# CDC uses Avro + Schema Registry by default (Redpanda on 8081 / host 18081)
ORCH_SCHEMA_REGISTRY_URL=http://cdc-message:8081
ORCH_KSQL_URL=http://cdc-ksqldb:8088
# KSQL DB feature: off by default. true turns on its API and page (and start ksqlDB: install.sh without --no-ops).
ORCH_KSQL_ENABLED=false
# Copy & Sync timeline (ADR 0009): history kept per profile; run watcher interval.
ORCH_TOOL_EVENTS_RETENTION_DAYS=365
ORCH_TOOL_EVENTS_MAX_ROWS=200000
ORCH_TOOL_EVENTS_POLL_SECS=15
# WireGuard tunnels to sites whose databases are not exposed (ADR 0010; docs/wireguard-sites.md).
ORCH_WIREGUARD_URL=http://cdc-wireguard:8091
# Shared by the orchestrator and cdc-wireguard; set a long random value in production.
ORCH_WIREGUARD_TOKEN=

# Auth — REQUIRED when APP_MODE=Production or ORCH_REQUIRE_AUTH=true (min 24 chars)
# ORCH_API_TOKEN=replace-with-long-random-token-here

# rqlite stores pipelines, drafts, notification rules, and processing specs
ORCH_RQLITE_URL=http://cdc-rqlite:4001
# ORCH_RQLITE_USER=
# ORCH_RQLITE_PASS=

# JDBC Type 4 control-plane admin (catalog, validate, DDL, preview)
ORCH_JDBC_ADMIN_URL=http://cdc-jdbc-admin:8084
# ORCH_JDBC_ADMIN_TOKEN=

# Separate Kafka-native cdc-processor data plane
# CDC_BOOTSTRAP_SERVERS=127.0.0.1:19092
# CDC_PIPELINE_CONFIG=examples/customer-pipeline.json
# DATA_SERVICE_API_KEY=your-api-key

# ── Publish / bind ────────────────────────────────────────────
# Docker install.sh defaults below. For local cargo use .env_local (4320–4328)
# so ports stay clear of Agentics 4300–4317. Native UI: kafbat-webui/.env_local.
CDC_ORCHESTRATOR_IMAGE=cdc-orchestrator:local
CDC_ORCHESTRATOR_BIND=127.0.0.1
CDC_ORCHESTRATOR_PORT=9788
CDC_CONNECT_HOST_PORT=28083
# Kafbat UI (ops profile). 4321 is the native UI break-glass admin port.
CDC_ADMIN_HOST_PORT=28080
# Level 2 (forked Kafbat UI image override):
# CDC_ADMIN_IMAGE=ghcr.io/<your-org>/kafka-ui:ux-v1
# Level 3 native UI (profile: native-ui):
# CDC_NATIVE_UI_IMAGE=kafbat-webui:local
CDC_NATIVE_UI_HOST_PORT=4320
# Native UI auth: none | local | sso. local = standalone login (default admin / admin)
# AUTH_MODE=local
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# Break-glass admin listener (2nd process in cdc-native-ui): always AUTH_MODE=local with the
# ADMIN_* credentials above, bound to 127.0.0.1 only — reach it when SSO is down.
# Change ADMIN_PASSWORD from the default when AUTH_MODE=sso. Remote: ssh -L 4321:127.0.0.1:4321
# CDC_NATIVE_UI_ADMIN_PORT=4321
# ADMIN_SESSION_SECRET=   # >=32 chars to survive restarts; empty = ephemeral
CDC_KAFKA_HOST_PORT=19092
CDC_SCHEMA_REGISTRY_HOST_PORT=18081
CDC_KSQL_HOST_PORT=28088
CDC_REDIS_HOST_PORT=26379
CDC_RQLITE_HOST_PORT=14001
CDC_POSTGRES_HOST_PORT=25432
CDC_POSTGRES_TARGET_HOST_PORT=25433

# ── Phase 3A Redpanda resource settings ──────────────────────
# Used with the production overlays. The portable overlay keeps shared-host
# compatibility flags; the dedicated Linux overlay removes --overprovisioned.
CDC_REDPANDA_SMP=1
CDC_REDPANDA_MEMORY=2G
CDC_REDPANDA_RESERVE_MEMORY=256M

# ── Phase 2 Kafka Connect production tuning ──────────────────
CDC_CONNECT_HEAP_OPTS=-Xms1g -Xmx2g
CDC_CONNECT_PRODUCER_COMPRESSION_TYPE=lz4
CDC_CONNECT_PRODUCER_BATCH_SIZE=131072
CDC_CONNECT_PRODUCER_LINGER_MS=20
CDC_CONNECT_CONSUMER_MAX_POLL_RECORDS=500
# Keep the current effective 60-second flush for the first rollout. A shorter
# interval is a separate measured change after restart/replay validation.
CDC_CONNECT_OFFSET_FLUSH_INTERVAL_MS=60000
CDC_CONNECT_OFFSET_FLUSH_TIMEOUT_MS=5000

# Phase 4 Redpanda/topic policy. Phase 2 never applies these values.
# The current live cluster was observed with 7-day retention and 128 MiB segments.
CDC_REDPANDA_RETENTION_APPLY=false
CDC_REDPANDA_RETENTION_MS=604800000
CDC_REDPANDA_DLQ_RETENTION_MS=2592000000
CDC_REDPANDA_SEGMENT_BYTES=134217728
CDC_REDPANDA_RETENTION_BYTES=

# ── Demo Postgres source + target (--profile demo) ────────────
CDC_DEMO_PG_USER=demo
CDC_DEMO_PG_PASSWORD=demo
CDC_DEMO_PG_DB=demo
# Dump window loaded into source on first init: 3m | 6m | 1y | 2y
CDC_DEMO_DUMP_SIZE=3m

# ── MCP (--profile mcp) ───────────────────────────────────────
MCP_CDC_IMAGE=mcp-cdc:local
MCP_CDC_BIND=127.0.0.1
MCP_CDC_PORT=8410
# One key per client (ADR 0008): name:scope:token, comma separated; scope = read | write.
# Generate keys with: openssl rand -hex 24. Weak or placeholder keys stop mcp-cdc from starting.
#MCP_CLIENT_KEYS=ops:write:<hex>,bi-agent:read:<hex>
# Legacy single key = client "default" with write scope. install.sh generates it when missing.
MCP_BEARER_TOKEN=
#MCP_RATE_LIMIT_RPM=300
# Set true for Cursor/agent prompting (create/start pipelines). Keep false in shared/prod.
ALLOW_WRITE_TOOLS=false

# pgcopydb sidecar
ORCH_PGCOPY_URL=http://cdc-pgcopydb:8085
ORCH_PGCOPY_TOKEN=
# Postgres remote dump / dump→restore sidecar (cdc-pgdump). Dump files live in volume
# cdc-pgdump-data and are removed PGDUMP_RETENTION_HOURS after the job finishes.
ORCH_PGDUMP_URL=http://cdc-pgdump:8089
ORCH_PGDUMP_TOKEN=
# CDC_PGDUMP_PG_MAJOR=18          # pg_dump major; must be >= every source server
# CDC_PGCOPY_PG_MAJOR=18          # pgcopydb image's pg_dump major; must be >= every source server
# PGDUMP_MAX_CONCURRENT=2
# PGDUMP_MIN_FREE_MB=1024
# PGDUMP_TIMEOUT_SECONDS=0        # 0 = no limit
# PGDUMP_RETENTION_HOURS=72
# Host-to-host file sync over SSH (cdc-rsync, ADR 0007): direct source → target via a forwarded
# key, or relay through the sidecar. Relay copies live in cdc-rsync-data, one per profile.
ORCH_RSYNC_URL=http://cdc-rsync:8090
ORCH_RSYNC_TOKEN=
# RSYNC_MAX_CONCURRENT=2
# RSYNC_MIN_FREE_MB=1024          # relay runs refuse to start below this
# RSYNC_TIMEOUT_SECONDS=0         # 0 = no limit
# RSYNC_RETENTION_HOURS=168       # finished job records
# RSYNC_STAGING_RETENTION_DAYS=14 # unused relay copies
CDC_PGCOPY_IMAGE=cdc-pgcopydb:local
