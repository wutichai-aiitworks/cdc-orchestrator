# Hyper CDC — production configuration (non-secret).
#
#   cp .env.example .env
#   ./deploy.sh secrets        # creates ./secrets/* (random tokens; lists what to fill by hand)
#   edit the REPLACE_ME_* values below
#
# Credentials are NOT here: they are Docker secrets, one file each under ./secrets/
# (see README "Secrets"). Image references live in images.env.

# ── Compose ───────────────────────────────────────────────────────
# `agent` starts mcp-cdc + cdc-vector. Empty = core + sidecars only.
COMPOSE_PROFILES=agent

# ── Deployment mode (ADR 0011) ────────────────────────────────────
# Production (no ribbon, hardened) | Maintenance (amber ribbon) | Enhanced (violet ribbon)
APP_MODE=Production
RUST_LOG=info

# ── Orchestrator ──────────────────────────────────────────────────
ORCH_REQUIRE_AUTH=true
ORCH_REQUIRE_PERSISTENCE=true
ORCH_STRICT_PERSISTENCE=true
# Optional: explicit CORS allow-list (comma separated). Empty = same-origin only.
ORCH_CORS_ORIGINS=
# Public WebUI URL for "Open in CDC" links in notifications.
ORCH_PUBLIC_UI_URL=https://cdc.example.com
ORCH_COMMAND_TIMEOUT_SECS=30
ORCH_POLL_INTERVAL_MS=30000
ORCH_HISTORY_CAPACITY=500
ORCH_STOP_DELETES_CONNECTOR=false
ORCH_LATENCY_SAMPLE_SECS=15
ORCH_RECORD_DIFF_CONCURRENCY=2
ORCH_TOOL_EVENTS_RETENTION_DAYS=365
ORCH_TOOL_EVENTS_MAX_ROWS=200000
ORCH_TOOL_EVENTS_POLL_SECS=15
ORCH_AUDIT_REDIS_MAX_LEN=100000
ORCH_AUDIT_RQLITE_MAX_ROWS=200000
# ksqlDB is not part of this stack; leave disabled.
ORCH_KSQL_ENABLED=false

# ── Host bindings ─────────────────────────────────────────────────
# Infra ports (Kafka, Schema Registry, Connect, Redis, rqlite) — loopback only.
# Reach them remotely with an SSH / SSM tunnel; never 0.0.0.0 (Redis/rqlite have no auth).
CDC_HOST_BIND=127.0.0.1
CDC_KAFKA_HOST_PORT=19092
CDC_SCHEMA_REGISTRY_HOST_PORT=18081
CDC_CONNECT_HOST_PORT=28083
CDC_REDIS_HOST_PORT=26379
CDC_RQLITE_HOST_PORT=14001
# Orchestrator API — loopback; the WebUI talks to it over server_zone.
CDC_ORCHESTRATOR_BIND=127.0.0.1
CDC_ORCHESTRATOR_PORT=9788
# WebUI — 127.0.0.1 when a proxy / tunnel on this host fronts it; 0.0.0.0 behind an ALB
# (restrict the security group to the ALB).
CDC_NATIVE_UI_BIND=0.0.0.0
CDC_NATIVE_UI_HOST_PORT=4320
CDC_NATIVE_UI_ADMIN_PORT=4321

# ── Native WebUI auth (ADR 0002) ──────────────────────────────────
APP_NAME=CDC WebUI
# sso   = SuperTokens/Authelia login (fill the SSO_* block + secrets/sso_app_secret)
# local = ADMIN_USERNAME + secrets/admin_password only; SSO_* may stay as placeholders
AUTH_MODE=sso
# Break-glass admin user (password: secrets/admin_password).
ADMIN_USERNAME=REPLACE_ME_ADMIN_USER
# true when served over https (required for Secure cookies).
SESSION_COOKIE_SECURE=true
# true only behind a proxy that overwrites X-Forwarded-For (e.g. an AWS ALB).
TRUST_PROXY=false

# SSO via SuperTokens gateway (app secret: secrets/sso_app_secret).
# SSO_CALLBACK_URL must be registered on the SSO app's redirect URIs.
# On EC2, SSO_EXCHANGE_URL must be the gateway's reachable https URL — the
# proxy-supertokens-gateway container only exists on the goldmine server_zone.
SSO_PROVIDER=supertokens_gateway
SSO_APP_ID=REPLACE_ME_SSO_APP_ID
SSO_LOGIN_URL=https://access.business-iq.work/auth/login
SSO_CALLBACK_URL=https://cdc.example.com/auth/callback
SSO_EXCHANGE_URL=REPLACE_ME_SSO_EXCHANGE_URL
SSO_TOKEN_URL=
SSO_EXCHANGE_TIMEOUT_MS=12000
# Authelia (only when SSO_PROVIDER=authelia; client secret: secrets/authelia_client_secret)
AUTHELIA_AUTHORIZE_URL=
AUTHELIA_CLIENT_ID=
AUTHELIA_TOKEN_URL=
AUTHELIA_USERINFO_URL=

# ── Redpanda resources (--overprovisioned is fixed on: EC2 is a VM) ──
CDC_REDPANDA_SMP=1
CDC_REDPANDA_MEMORY=2G
CDC_REDPANDA_RESERVE_MEMORY=256M

# ── Kafka Connect tuning ──────────────────────────────────────────
CDC_CONNECT_HEAP_OPTS=-Xms1g -Xmx2g
CDC_CONNECT_PRODUCER_COMPRESSION_TYPE=lz4
CDC_CONNECT_PRODUCER_BATCH_SIZE=131072
CDC_CONNECT_PRODUCER_LINGER_MS=20
CDC_CONNECT_CONSUMER_MAX_POLL_RECORDS=500
CDC_CONNECT_OFFSET_FLUSH_INTERVAL_MS=60000
CDC_CONNECT_OFFSET_FLUSH_TIMEOUT_MS=5000

# ── Topic retention (applied by ../scripts/configure-topic-retention.sh) ──
CDC_REDPANDA_RETENTION_APPLY=false
CDC_REDPANDA_RETENTION_MS=604800000
CDC_REDPANDA_DLQ_RETENTION_MS=2592000000
CDC_REDPANDA_SEGMENT_BYTES=134217728
CDC_REDPANDA_RETENTION_BYTES=

# ── Sidecar limits ────────────────────────────────────────────────
REDIS_SHAKE_MAX_CONCURRENT_JOBS=1
REDIS_SHAKE_RETAIN_JOBS=15
PGDUMP_MAX_CONCURRENT=2
PGDUMP_MIN_FREE_MB=1024
PGDUMP_TIMEOUT_SECONDS=0
PGDUMP_RETENTION_HOURS=72
RSYNC_MAX_CONCURRENT=2
RSYNC_MIN_FREE_MB=1024
RSYNC_TIMEOUT_SECONDS=0
RSYNC_RETENTION_HOURS=168
RSYNC_STAGING_RETENTION_DAYS=14
RSYNC_SSH_TIMEOUT_SECONDS=15
WG_FORWARD_PORT_MIN=21000
WG_FORWARD_PORT_MAX=21999

# ── AI agent: mcp-cdc (profile agent; keys: secrets/mcp_client_keys) ──
MCP_CDC_BIND=127.0.0.1
MCP_CDC_PORT=8410
# Keep false in production (preflight enforces it).
ALLOW_WRITE_TOOLS=false
MCP_RATE_LIMIT_RPM=300
MCP_CORS_ORIGINS=
# OAuth for claude.ai / ChatGPT connectors (ADR 0017): needs a public https URL.
MCP_OAUTH=false
MCP_PUBLIC_URL=

# ── AI agent: cdc-vector → OpenObserve (password: secrets/o2_password) ──
# On EC2, point at OpenObserve's reachable URL (openobserve-core is goldmine-only).
O2_URL=REPLACE_ME_O2_URL
O2_ORG=default
O2_STREAM=cdc-copy
O2_USER=REPLACE_ME_O2_USER

# ── Container log rotation ────────────────────────────────────────
CDC_LOG_MAX_SIZE=20m
CDC_LOG_MAX_FILE=5

# ── deploy.sh notifications (optional) ────────────────────────────
# Webhook URL and auth live in secrets/deploy_discord_webhook, secrets/deploy_o2_auth_b64.
DEPLOY_O2_URL=
