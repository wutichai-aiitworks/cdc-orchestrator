# Release manifest: which image every service runs. Images are on Docker Hub under the
# `wutichai` namespace (Woodpecker secret REGISTRY_NAMESPACE).
#
# Three ways to fill it, best first:
#
#  1. Woodpecker release file — for a v* tag, Woodpecker attaches images-<version>.env to
#     the Discord message (also printed at the end of the build-and-push log):
#        ./deploy.sh up --images images-v1.2.3.env
#
#  2. Resolve from Docker Hub — pins every image to its current digest for a tag:
#        ./deploy.sh images v1.2.3            # or a branch build: test_1bb2c3c
#        ./deploy.sh up
#
#  3. Tag only (this file as-is) — compose builds <CDC_REGISTRY>/<image>:<CDC_VERSION>.
#     Not digest-pinned: a re-pushed tag changes what runs. Quick tests only.
CDC_REGISTRY=wutichai
CDC_VERSION=latest

# ── Woodpecker-built (12), filled by option 1 or 2 ────────────────
# CDC_ORCHESTRATOR_IMAGE=wutichai/cdc-orchestrator:vX.Y.Z@sha256:...
# CDC_CONNECT_IMAGE=wutichai/cdc-connect:vX.Y.Z@sha256:...
# CDC_NATIVE_UI_IMAGE=wutichai/cdc-webui:vX.Y.Z@sha256:...
# MCP_CDC_IMAGE=wutichai/cdc-mcp:vX.Y.Z@sha256:...
# CDC_JDBC_ADMIN_IMAGE=wutichai/cdc-jdbc-admin:vX.Y.Z@sha256:...
# CDC_WIREGUARD_IMAGE=wutichai/cdc-wireguard:vX.Y.Z@sha256:...
# CDC_PGCOPY_IMAGE=wutichai/cdc-pgcopydb:vX.Y.Z@sha256:...
# CDC_PGDUMP_IMAGE=wutichai/cdc-pgdump:vX.Y.Z@sha256:...
# CDC_PGLOADER_IMAGE=wutichai/cdc-pgloader:vX.Y.Z@sha256:...
# CDC_REDIS_SHAKE_IMAGE=wutichai/cdc-redisshake:vX.Y.Z@sha256:...
# CDC_MONGOCOPY_IMAGE=wutichai/cdc-mongocopy:vX.Y.Z@sha256:...
# CDC_RSYNC_IMAGE=wutichai/cdc-rsync:vX.Y.Z@sha256:...

# ── Upstream (pinned in compose; override only to bump deliberately) ──
# CDC_REDPANDA_IMAGE=docker.redpanda.com/redpandadata/redpanda:v24.2.4
# CDC_RQLITE_IMAGE=rqlite/rqlite:8.36.16
# CDC_REDIS_IMAGE=redis:7.4-alpine
# CDC_VECTOR_IMAGE=timberio/vector:0.41.1-alpine
