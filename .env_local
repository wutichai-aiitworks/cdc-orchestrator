# Local cargo (`./start.sh --build .env_local`)
# Native UI: kafbat-webui/start.sh --build .env_local
#
# Native UI (kafbat-webui) host port is 4320 via Compose `.env`.
# Cargo start.sh must not bind 4320 while cdc-native-ui is running.
#
# Infra host ports match the already-running `cdc-stack` from install.sh / .env
# (Connect 28083, Kafbat 4321, Kafka 19092). Do not remap those unless you recreate compose.

ORCH_ENV=dev
ORCH_ENABLED=true
ORCH_HOST=0.0.0.0
ORCH_PORT=9788
ORCH_ENGINE_PROVIDER=docker_api
ORCH_CONTAINER_PROJECT_NAME=cdc-stack
ORCH_MANAGED_CONTAINERS=cdc-message,cdc-admin,cdc-connect,cdc-ksqldb,cdc-redis,cdc-vector
ORCH_CONNECT_BASE_URL=http://127.0.0.1:28083
ORCH_REDPANDA_CONTAINER=cdc-message
ORCH_COMMAND_TIMEOUT_SECS=30
ORCH_POLL_INTERVAL_MS=30000
ORCH_HISTORY_CAPACITY=500
ORCH_STOP_DELETES_CONNECTOR=false
ORCH_SCHEMA_REGISTRY_URL=http://cdc-message:8081
ORCH_KSQL_URL=http://127.0.0.1:28088
ORCH_CORS_ORIGINS=http://127.0.0.1:4320,http://localhost:4320
# Optional auth token for non-health endpoints
# ORCH_API_TOKEN=replace-with-secure-token

# Optional rqlite (compose publishes 14001)
ORCH_RQLITE_URL=http://127.0.0.1:14001

# Optional jdbc-admin (published only on server_zone by default)
# ORCH_JDBC_ADMIN_URL=http://127.0.0.1:8084
# ORCH_JDBC_ADMIN_TOKEN=

# ── Local processes ───────────────────────────────────────────
CDC_ORCHESTRATOR_IMAGE=cdc-orchestrator:local
CDC_ORCHESTRATOR_BIND=127.0.0.1
CDC_ORCHESTRATOR_PORT=9788
CDC_NATIVE_UI_HOST_PORT=4320

# ── Existing cdc-stack host ports (install.sh / .env) ─────────
CDC_CONNECT_HOST_PORT=28083
CDC_ADMIN_HOST_PORT=4321
CDC_KAFKA_HOST_PORT=19092
CDC_REDIS_HOST_PORT=26379
CDC_POSTGRES_HOST_PORT=25432
CDC_POSTGRES_TARGET_HOST_PORT=25433
MCP_CDC_PORT=8410
CDC_FUNCTION_HOST_PORT=4328

CDC_BOOTSTRAP_SERVERS=127.0.0.1:19092

# ── Demo Postgres source + target (--profile demo / install.sh --demo) ──
CDC_DEMO_PG_USER=demo
CDC_DEMO_PG_PASSWORD=demo
CDC_DEMO_PG_DB=demo
CDC_DEMO_DUMP_SIZE=3m

# ── MCP (--profile mcp) ───────────────────────────────────────
MCP_CDC_IMAGE=mcp-cdc:local
MCP_CDC_BIND=127.0.0.1
MCP_BEARER_TOKEN=change-me-mcp-cdc-token-min24chars
# true = Cursor/agents can create and start pipelines from prompts
ALLOW_WRITE_TOOLS=true
