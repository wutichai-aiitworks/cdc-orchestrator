HOST=0.0.0.0
PORT=4320
APP_NAME="Hyper CDC WebUI"
# Compose native UI is 4320; orchestrator remains http://127.0.0.1:9788
PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:9788
ORCHESTRATOR_URL=http://127.0.0.1:9788
ORCHESTRATOR_TOKEN=

# Auth: none | local | sso
# local = standalone username/password login (defaults admin / admin)
AUTH_MODE=none
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# >=32 chars; optional for local (ephemeral if unset), required for sso
# SESSION_SECRET=

# Set true to log /auth/custom-sso/exchange request and response
# SSO_EXCHANGE_DEBUG=true
