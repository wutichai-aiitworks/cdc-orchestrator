# ── .env.example (development) ─────────────────────────────────
# APP_MODE — the one deployment-mode variable: Production | Maintenance | Enhanced.
#   Production  : no ribbon; requires a strong APP_API_TOKEN + database (APP_REQUIRE_* override)
#   Maintenance : amber corner ribbon — stable release, fixes only
#   Enhanced    : violet corner ribbon — new features in development
APP_MODE=Enhanced

# ── .env.production.example ────────────────────────────────────
# APP_MODE=Production
# Production turns these on by default; keep them explicit so a Maintenance/Enhanced deploy keeps them.
# APP_REQUIRE_AUTH=true
# APP_REQUIRE_PERSISTENCE=true
# APP_STRICT_PERSISTENCE=true
